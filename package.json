{
  "name": "chessbox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
   
  "dev": "concurrently -n api,desktop -c blue,magenta \"npx tsx --env-file=apps/api/.env apps/api/src/index.ts\" \"npm start --workspace=apps/desktop\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "concurrently": "^10.0.4",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "typescript": "^5.9.3"
  }
}
